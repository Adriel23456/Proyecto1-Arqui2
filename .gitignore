# =========================
# Visual Studio / VSCode
# =========================
# Ignora TODO dentro de .vs ... 
.vs/**
# ...pero permite que Git vea los directorios e incluya unos JSON clave
!.vs/
!.vs/**/
!.vs/**/launch.vs.json
!.vs/**/ProjectSettings.json
!.vs/**/VSWorkspaceState.json
# (todo lo demás en .vs sigue ignorado por la primera regla)

.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# CMake (árboles de build)
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
**/compile_commands.json

# =========================
# VC++ intermediates / caches
# =========================
*.ipch
ipch/
*.iobj
*.ipdb
*.pdb
*.obj
*.tlog
*.lastbuildstate
*.idb
*.ilk
*.pch
*.cache

# Bases de datos de VS
*.VC.db
*.VC.opendb
*.sdf
*.opensdf

# Otros
*.db
*.opendb
*.aps
*.ncb
*.tld
*.log

# =========================
# Binarios (por defecto ignorados)
# =========================
*.exe
*.lib
*.so
*.a
*.dylib
*.pdb

# =========================
# NuGet (opcional)
# =========================
/packages/
!packages/build/
*.nupkg

# --- Allow-list: TODO lo de thirdparty, incluso x64/x86 y binarios ---
!MainProgram/thirdparty/
!MainProgram/thirdparty/**

# Por si existe algún ignore agresivo de x64/x86 en otro .gitignore/global:
!MainProgram/thirdparty/**/x64/
!MainProgram/thirdparty/**/x64/**
!MainProgram/thirdparty/**/x86/
!MainProgram/thirdparty/**/x86/**

# Y levanta los binarios dentro de thirdparty
!MainProgram/thirdparty/**/*.[Dd][Ll][Ll]
!MainProgram/thirdparty/**/*.[Ll][Ii][Bb]
!MainProgram/thirdparty/**/*.[Pp][Dd][Bb]
!MainProgram/thirdparty/**/*.[Ss][Oo]
!MainProgram/thirdparty/**/*.[Aa]
!MainProgram/thirdparty/**/*.[Dd][Yy][Ll][Ii][Bb]
.vs/
**/.vs/

.vscode/

# Salidas/build
out/
**/out/
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt